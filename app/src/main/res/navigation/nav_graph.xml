<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.myapplication.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.myapplication.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_alphabetFragment"
            app:destination="@id/alphabetFragment" />
        <action
            android:id="@+id/action_homeFragment_to_numbersFragment"
            app:destination="@id/numbersFragment" />
        <action
            android:id="@+id/action_homeFragment_to_colorsFragment"
            app:destination="@id/colorsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_shapesFragment"
            app:destination="@id/shapesFragment" />
        <action
            android:id="@+id/action_homeFragment_to_animalsFragment"
            app:destination="@id/animalsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_storyFragment"
            app:destination="@id/storyFragment" />
        <action
            android:id="@+id/action_homeFragment_to_drawingFragment"
            app:destination="@id/drawingFragment" />
        <action
            android:id="@+id/action_homeFragment_to_puzzleFragment"
            app:destination="@id/puzzleFragment" />
        <action
            android:id="@+id/action_homeFragment_to_cameraFragment"
            app:destination="@id/cameraFragment" />
        <action
            android:id="@+id/action_homeFragment_to_parentDashboardFragment"
            app:destination="@id/parentDashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/alphabetFragment"
        android:name="com.example.myapplication.ui.learning.AlphabetFragment"
        android:label="Alphabet"
        tools:layout="@layout/fragment_alphabet" />

    <fragment
        android:id="@+id/numbersFragment"
        android:name="com.example.myapplication.ui.learning.NumbersFragment"
        android:label="Numbers"
        tools:layout="@layout/fragment_numbers" />

    <fragment
        android:id="@+id/colorsFragment"
        android:name="com.example.myapplication.ui.learning.ColorsFragment"
        android:label="Colors"
        tools:layout="@layout/fragment_colors" />

    <fragment
        android:id="@+id/shapesFragment"
        android:name="com.example.myapplication.ui.learning.ShapesFragment"
        android:label="Shapes"
        tools:layout="@layout/fragment_shapes" />

    <fragment
        android:id="@+id/animalsFragment"
        android:name="com.example.myapplication.ui.learning.AnimalsFragment"
        android:label="Animals"
        tools:layout="@layout/fragment_animals" />

    <fragment
        android:id="@+id/storyFragment"
        android:name="com.example.myapplication.ui.learning.StoryFragment"
        android:label="Story"
        tools:layout="@layout/fragment_story" />

    <fragment
        android:id="@+id/drawingFragment"
        android:name="com.example.myapplication.ui.drawing.DrawingFragment"
        android:label="Art Studio"
        tools:layout="@layout/fragment_drawing" />

    <fragment
        android:id="@+id/puzzleFragment"
        android:name="com.example.myapplication.ui.learning.PuzzleFragment"
        android:label="Shape Match"
        tools:layout="@layout/fragment_puzzle" />

    <fragment
        android:id="@+id/cameraFragment"
        android:name="com.example.myapplication.ui.camera.CameraFragment"
        android:label="Camera"
        tools:layout="@layout/fragment_camera" />

    <fragment
        android:id="@+id/parentDashboardFragment"
        android:name="com.example.myapplication.ui.parent.ParentDashboardFragment"
        android:label="Parent Dashboard"
        tools:layout="@layout/fragment_parent_dashboard" />

</navigation>